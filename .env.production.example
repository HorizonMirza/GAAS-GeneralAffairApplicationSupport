# =================================================================
# GAAS - Konfigurasi Lingkungan Produksi (Server Kantor SIG)
# Salin file ini menjadi `.env` di server sebelum menjalankan:
#   docker compose up -d --build
# =================================================================

# Port Nginx yang diexpose ke jaringan kantor SIG (Default: 80 atau 8080)
PORT=80

# Kredensial Database PostgreSQL
DB_NAME=pengiriman_barang
DB_USER=pengiriman_app
DB_PASSWORD=GantiDenganPasswordSangatKuatDanRahasia2026!

# Kunci Rahasia JWT (Minimal 64 karakter acak untuk keamanan HMAC-SHA256)
JWT_SECRET=gaas-prod-sig-enterprise-key-b8f2d1e0a7c49b6d8e2f5a1c3e7b9d0f2a4c6e8b1d3f5a7c9e2b4d6f8a0c2e4

# Masa aktif token JWT dalam menit (480 menit = 8 jam kerja)
JWT_EXPIRE_MINUTES=480

# URL Domain / IP Kantor SIG yang diizinkan untuk CORS
# Contoh jika memakai IP internal: http://10.10.20.50
# Contoh jika memakai domain internal: http://gaas.sig.id,https://gaas.sig.id
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080

# Endpoint API publik untuk Frontend (Gunakan /api jika diakses via reverse proxy Nginx)
NEXT_PUBLIC_API_BASE_URL=/api
