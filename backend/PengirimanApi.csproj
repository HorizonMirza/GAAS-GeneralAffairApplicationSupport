<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Skips generating the native PengirimanApi.exe launcher - "dotnet run"/"dotnet watch" then
         start the app by running the .dll directly through dotnet.exe itself instead of spawning
         that unsigned .exe, which is what some Windows Application Control / Smart App Control
         policies block on a freshly-built binary. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="QuestPDF" Version="2024.10.4" />
    <!-- Apache-2.0-licensed 2.x line (pinned below the 3.x Six Labors Split License) - only used to
         normalize profile/cover photo uploads to a consistent resolution on save, see
         ProfileController. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Company logo embedded in the Bukti Booking Ruang Meeting PDF - see BookingPdfService. -->
    <None Include="Assets\logo-pgm-solution.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
